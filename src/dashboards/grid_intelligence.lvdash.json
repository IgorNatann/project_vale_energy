{
  "datasets": [
    {
      "name": "operacao",
      "displayName": "Operação nos últimos 30 dias de dados",
      "queryLines": [
        "SELECT dia, id_conjunto, nome_conjunto, qtd_chamados, chamados_risco_saude, uc_horas_interrompidas FROM painel_operacional_dia WHERE dia > date_sub((SELECT max(dia) FROM painel_operacional_dia), 30) ORDER BY dia"
      ]
    },
    {
      "name": "acoes",
      "displayName": "Ações no último dia disponível",
      "queryLines": [
        "SELECT dia, nome_conjunto, qtd_interrupcoes, qtd_chamados, chamados_risco_saude, mencoes_ouvidoria, acao_recomendada FROM painel_operacional_dia WHERE dia = (SELECT max(dia) FROM painel_operacional_dia) ORDER BY nome_conjunto"
      ]
    },
    {
      "name": "dec",
      "displayName": "DEC por conjunto no último mês",
      "queryLines": [
        "SELECT `Conjunto` AS conjunto, MEASURE(`DEC`) AS dec FROM continuidade_metricas WHERE `Mes` = (SELECT max(mes_apuracao) FROM continuidade_conjunto_mes) GROUP BY `Conjunto` ORDER BY dec DESC"
      ]
    },
    {
      "name": "prioridades",
      "displayName": "Prioridade de inspeção atual",
      "queryLines": [
        "SELECT id_uc, nome_conjunto, bairro, classe_consumo, prioridade_inspecao, variacao_da_uc, variacao_do_conjunto, sinal_violacao_recente, motivo_observado FROM prioridade_inspecao_uc"
      ]
    },
    {
      "name": "clientes",
      "displayName": "Clientes com sinal alto de ouvidoria",
      "queryLines": [
        "SELECT id_cliente, nome_conjunto, bairro, qtd_chamados, qtd_mencoes_ouvidoria, risco_ouvidoria, ultima_fala FROM saude_cliente WHERE risco_ouvidoria = 'alto' ORDER BY qtd_mencoes_ouvidoria DESC, qtd_chamados DESC, id_cliente"
      ]
    }
  ],
